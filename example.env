# Copy this file to .env and fill in real values. Never commit .env itself.

# Apify API token — from https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Base64-encoded Google service-account JSON key.
# Generate with: base64 -i path/to/service-account.json | tr -d '\n'
JSON_KEY_BASE_64=your_base64_key_here

# Google Sheet ID — the long string in the sheet's URL between /d/ and /edit
SHEET_ID=your_sheet_id_here
